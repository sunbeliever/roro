maze.com/episodes/3784599"},"show":{"href":"https://api.tvmaze.com/shows/88082","name":"Where the Mask Ends"}},"_embedded":{"show":{"id":88082,"url":"https://www.tvmaze.com/shows/88082/where-the-mask-ends","name":"Where the Mask Ends","type":"Scripted","language":"Chinese","genres":["Drama","Romance"],"status":"Running","runtime":null,"averageRuntime":51,"premiered":"2026-10-16","ended":null,"officialSite":"https://v.youku.com/v_show/id_XNjU3MzkyOTA0NA==.html","schedule":{"time":"12:00","days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]},"rating":{"average":null},"weight":85,"network":{"id":297,"name":"CCTV-8","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"webChannel":{"id":118,"name":"Youku","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/645/1613260.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/645/1613260.jpg"},"summary":"<p>Chou was once a lowly night-soil collector, bullied and mistreated by everyone around her. But her striking resemblance to Wei Rao, the daughter of a marquis, unexpectedly makes her the bride of Lu Zhuo, the heir to a duke's household, in a marriage arranged to bring him good fortune and save his life. Ambitious and determined to rise above her station, Chou sees the marriage as her chance to climb the social ladder. However, her critically ill husband suddenly awakens, and her assumption of another woman's place brings one disaster after another. Furious that Chou has taken her place, Wei Rao is desperate to get rid of her. Meanwhile, Lu Zhuo regards Chou as a vicious and scheming woman, constantly guarding against her and plotting against her. Beneath the seemingly harmonious facade of the duke's household lie countless traps and deadly schemes. Caught in the midst of these hidden conflicts, Chou struggles to navigate the competing interests around her while carefully planning her future. Determined to break free from the shackles of fate, she eventually uncovers the secrets of her own origins and reunites with her loved ones. Rising from a humble night-soil collector to a woman of status, she transforms her life and creates a brilliant future for herself.</p>","updated":1792870045,"_links":{"self":{"href":"https://api.tvmaze.com/shows/88082"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3784599","name":"Episode 18"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3784600","name":"Episode 19"}}}}},{"id":3656350,"url":"https://www.tvmaze.com/episodes/3656350/guangyin-zhi-wai-2x19-episode-45","name":"Episode 45","season":2,"number":19,"type":"regular","airdate":"2026-10-25","airtime":"","airstamp":"2026-10-25T04:00:00+00:00","runtime":null,"rating":{"average":null},"image":null,"summary":null,"_links":{"self":{"href":"https://api.tvmaze.com/episodes/3656350"},"show":{"href":"https://api.tvmaze.com/shows/89284","name":"Guangyin Zhi Wai"}},"_embedded":{"show":{"id":89284,"url":"https://www.tvmaze.com/shows/89284/guangyin-zhi-wai","name":"Guangyin Zhi Wai","type":"Animation","language":null,"genres":["Action","Adventure","Fantasy"],"status":"Running","runtime":null,"averageRuntime":null,"premiered":"2025-12-28","ended":null,"officialSite":null,"schedule":{"time":"10:00","days":["Sunday"]},"rating":{"average":null},"weight":62,"network":null,"webChannel":{"id":118,"name":"Youku","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/605/1513966.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/605/1513966.jpg"},"summary":null,"updated":1784396720,"_links":{"self":{"href":"https://api.tvmaze.com/show