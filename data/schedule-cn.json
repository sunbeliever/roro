ys":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]},"rating":{"average":null},"weight":59,"network":null,"webChannel":{"id":104,"name":"Tencent QQ","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":"https://v.qq.com/"},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/651/1629761.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/651/1629761.jpg"},"summary":"<p>Su Yunian infiltrates the glittering, decadent world of \"The Heart of Opulence\" to uncover the truth behind her sister's death, only to be swept into a deadly power struggle between Nie Feng and Tu Jiasheng. She soon learns her sister was silenced for possessing crucial evidence. As danger mounts, betrayed by her closest friend, framed by the top courtesan, and relentlessly pursued by Nie Feng, Su Yunian walks a razor's edge between enmity and alliance with Tu Jiasheng. In this realm of illusions, every glimmer hides a blood-stained lie.</p>","updated":1795637817,"_links":{"self":{"href":"https://api.tvmaze.com/shows/90079"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3824860","name":"Episode 17"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3824861","name":"Episode 18"}}}}},{"id":3822812,"url":"https://www.tvmaze.com/episodes/3822812/taming-the-husband-1x17-episode-17","name":"Episode 17","season":1,"number":17,"type":"regular","airdate":"2026-11-26","airtime":"12:00","airstamp":"2026-11-26T04:00:00+00:00","runtime":35,"rating":{"average":null},"image":null,"summary":null,"_links":{"self":{"href":"https://api.tvmaze.com/episodes/3822812"},"show":{"href":"https://api.tvmaze.com/shows/91202","name":"Taming the Husband"}},"_embedded":{"show":{"id":91202,"url":"https://www.tvmaze.com/shows/91202/taming-the-husband","name":"Taming the Husband","type":"Scripted","language":"Chinese","genres":["Drama","Romance"],"status":"Running","runtime":null,"averageRuntime":35,"premiered":"2026-11-18","ended":null,"officialSite":"https://www.mgtv.com/h/860383/24280968.html","schedule":{"time":"12:00","days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]},"rating":{"average":null},"weight":74,"network":{"id":276,"name":"Hunan TV","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"webChannel":{"id":226,"name":"Mango TV","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":"https://w.mgtv.com/"},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/653/1633196.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/653/1633196.jpg"},"summary":"<p>Jin Bao Zhu, the spirited daughter of a butcher, has always harbored simple, materialistic dreams of wealth and comfort. Desperate to escape her oppressive family life, she volunteers to enter a prestigious canal transport family as the concubine of their son, Xie Yan. However, her dreams of luxury quickly shatter: while Xie Yan was once a brilliant prodigy, he has been left disabled and disgraced by a tragic accident. Xie Yan has become bitter and self-destructive and resents Bao Zhu, who he feels has been forced upon him. The marriage gets off to a rough start, as Xie Yan and Bao Zhu are constantly fighting. But as they navigate the treacherous political schemes surrounding the canal transport industry and fend off ambitious relatives, their mutual animosity slowly transforms. Can they find a way to work together to save their crumbling family legacy and their marriage?</p>","updated":1795637960,"_links":{"self":{"href":"https://api.tvmaze.com/shows/91202"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3822812","name":"Episode 17"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3822813","name":"Episode 18"}}}}},{"id":