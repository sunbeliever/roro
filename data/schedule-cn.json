vmaze.com/shows/80484"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3790942","name":"Episode 24"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3790943","name":"Episode 25"}}}}},{"id":3784515,"url":"https://www.tvmaze.com/episodes/3784515/the-great-long-march-1x46-episode-46","name":"Episode 46","season":1,"number":46,"type":"regular","airdate":"2026-11-04","airtime":"20:00","airstamp":"2026-11-04T12:00:00+00:00","runtime":46,"rating":{"average":null},"image":null,"summary":null,"_links":{"self":{"href":"https://api.tvmaze.com/episodes/3784515"},"show":{"href":"https://api.tvmaze.com/shows/87677","name":"The Great Long March"}},"_embedded":{"show":{"id":87677,"url":"https://www.tvmaze.com/shows/87677/the-great-long-march","name":"The Great Long March","type":"Scripted","language":"Chinese","genres":["Drama","War"],"status":"Running","runtime":null,"averageRuntime":46,"premiered":"2026-10-09","ended":null,"officialSite":"https://v.qq.com/x/cover/mzc00200p1ilkw3.html","schedule":{"time":"20:00","days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]},"rating":{"average":null},"weight":51,"network":{"id":1282,"name":"CCTV-1","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"webChannel":{"id":104,"name":"Tencent QQ","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":"https://v.qq.com/"},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/645/1612878.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/645/1612878.jpg"},"summary":"<p>Revolving around the arduous Long March of the Central Red Army, it documents the historical process—from the army's failure in the fifth counter-encirclement campaign, to the First, Second, Fourth Front Armies of the Red Army and the 25th Red Army launching strategic transfers under the leadership of the CPC Central Committee—to eventual triumph. It extols the unyielding ideals and revolutionary spirit of Mao Zedong and Chinese Communists, and elucidates the history and logic behind the rise and development of the Chinese revolution, proving that adapting Marxism to China's specific conditions was essential for victory.</p>","updated":1793559834,"_links":{"self":{"href":"https://api.tvmaze.com/shows/87677"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3784514","name":"Episode 45"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3784515","name":"Episode 46"}}}}},{"id":3784516,"url":"https://www.tvmaze.com/episodes/3784516/the-great-long-march-1x47-episode-47","name":"Episode 47","season":1,"number":47,"type":"regular","airdate":"2026-11-04","airtime":"20:00","airstamp":"2026-11-04T12:00:00+00:00","runtime":46,"rating":{"average":null},"image":null,"summary":null,"_links":{"self":{"href":"https://api.tvmaze.com/episodes/3784516"},"show":{"href":"https://api.tvmaze.com/shows/87677","name":"The Great Long March"}},"_embedded":{"show":{"id":87677,"url":"https://www.tvmaze.com/shows/87677/the-great-long-march","name":"The Great Long March","type":"Scripted","language":"Chinese","genres":["Drama","War"],"status":"Running","runtime":null,"averageRuntime":46,"premiered":"2026-10-09","ended":null,"officialSite":"https://v.qq.com/x/cover/mzc00200p1ilkw3.html","schedule":{"time":"20:00","days":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"]},"rating":{"average":null},"weight":51,"network":{"id":1282,"name":"CCTV-1","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":null},"webChannel":{"id":104,"name":"Tencent QQ","country":{"name":"China","code":"CN","timezone":"Asia/Shanghai"},"officialSite":"https://v.qq.com/"},"dvdCountry":null,"externals":{"tvrage":null,"thetvdb":null,"imdb":null},"image":{"medium":"https://static.tvmaze.com/uploads/images/medium_portrait/645/1612878.jpg","original":"https://static.tvmaze.com/uploads/images/original_untouched/645/1612878.jpg"},"summary":"<p>Revolving around the arduous Long March of the Central Red Army, it documents the historical process—from the army's failure in the fifth counter-encirclement campaign, to the First, Second, Fourth Front Armies of the Red Army and the 25th Red Army launching strategic transfers under the leadership of the CPC Central Committee—to eventual triumph. It extols the unyielding ideals and revolutionary spirit of Mao Zedong and Chinese Communists, and elucidates the history and logic behind the rise and development of the Chinese revolution, proving that adapting Marxism to China's specific conditions was essential for victory.</p>","updated":1793559834,"_links":{"self":{"href":"https://api.tvmaze.com/shows/87677"},"previousepisode":{"href":"https://api.tvmaze.com/episodes/3784514","name":"Episode 45"},"nextepisode":{"href":"https://api.tvmaze.com/episodes/3784515","name":"Episode 46"}}}}}]}